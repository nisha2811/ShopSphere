# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit it.
SERVER_PORT=8088
# PostgreSQL (used by both the db and backend containers)
DB_NAME=shopsphere_db
DB_USERNAME=postgres
DB_PASSWORD=Nparekh@28

# JWT - generate a random 32+ character secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=jR0m/SYuC7GjX0Gi1cCkCj5cp/E06ikXFrB/XofQh3ATNl+LZJuoexk/rglftzPH
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Set this to how people will reach the site:
#   http://YOUR_EC2_PUBLIC_IP      (IP-only, no domain)
#   https://yourdomain.com         (once you've set up a domain + HTTPS)
FRONTEND_URL=http://localhost:5173

# Refresh-token cookie.
# IMPORTANT: if you are serving over plain HTTP (IP address, no TLS certificate),
# this MUST be "false", or the browser will silently refuse to store the cookie
# and login/refresh will break. Set it to "true" only once you have HTTPS set up.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# SMTP (use a Gmail "App Password", not your real Gmail password)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nishaparekh2811@gmail.com
MAIL_PASSWORD=zbtwmlijepmchjgu
MAIL_FROM=nishaparekh2811@gmail.com


# Demo/catalog seed data - fine to leave on for a portfolio deployment
SEED_DATA_ENABLED=true
SEED_DEMO_USERS=true
SEED_ADMIN_EMAIL=admin@shopsphere.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_EMAIL=customer@shopsphere.local
SEED_CUSTOMER_PASSWORD=Password@123

OPENAPI_ENABLED=false
