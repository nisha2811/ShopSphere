SERVER_PORT=8088

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# JWT - generate a unique random secret of at least 32 characters.
JWT_SECRET=shopsphere-local-development-secret-change-this-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend
FRONTEND_URL=http://localhost:5173

# Refresh-token cookie
# Keep false for local HTTP. Set true behind HTTPS in production.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# SMTP
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME

# Demo/catalog seed data
# Enable only for local/demo environments.
SEED_DATA_ENABLED=true
SEED_DEMO_USERS=true
SEED_ADMIN_EMAIL=admin@shopsphere.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_EMAIL=customer@shopsphere.local
SEED_CUSTOMER_PASSWORD=Password@123

# API documentation
# Keep disabled in production.
OPENAPI_ENABLED=false
